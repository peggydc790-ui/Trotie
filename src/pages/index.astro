---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getPublishedProducts, money } from '../lib/products';
import { genericWhatsAppUrl } from '../lib/whatsapp';
const products = getPublishedProducts();
const featured = products.slice(0, 4);
const wa = genericWhatsAppUrl();
---
<Base>
  <Header />
  <main>
    <section class="hero">
      <img src="/assets/lifestyle/hero-watch.jpg" alt="A watch in the TROTIE MAISON house" />
      <div class="shade"></div>
      <p class="masthead">TROTIE MAISON</p>
      <div class="hero-copy">
        <h1 class="slogan">Made for the top member</h1>
        <div class="glass" role="group" aria-label="Actions">
          <a class="on" href="/collection">Collection</a>
          <a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="lookbook" aria-label="The house">
      <article class="band">
        <img src="/assets/lifestyle/band-chrome.jpg" alt="" />
        <p>A season of details worth keeping.</p>
      </article>
      <article class="band">
        <img src="/assets/lifestyle/band-glove.jpg" alt="" />
        <p>Form follows feel.</p>
      </article>
      <article class="band">
        <img src="/assets/lifestyle/band-cards.jpg" alt="" />
        <p>Games, in good company.</p>
      </article>
      <article class="band">
        <img src="/assets/lifestyle/band-burgundy.jpg" alt="" />
        <p>Substance beneath the surface.</p>
      </article>
    </section>

    {featured.length ? (
      <section class="grid container">
        {featured.map((p) => (
          <a class="card" href={`/piece/${p.slug}`}>
            <div class="photo"><img src={p.images[0]} alt={p.name} /><em>{p.status}</em></div>
            <div class="meta"><h3>{p.name}</h3><strong>{money(p.price_ngn)}</strong></div>
          </a>
        ))}
      </section>
    ) : (
      <section class="empty">
        <h2 class="display">No pieces are listed at the moment.</h2>
        <a class="btn primary" href={wa} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp</a>
      </section>
    )}
  </main>
  <Footer />
</Base>
<style>

.masthead {
  position: absolute;
  top: 18px;
  left: 0;
  right: 0;
  z-index: 2;
  margin: 0;
  text-align: center;
  font-family: "TM Classic", "Palatino Linotype", Palatino, serif;
  font-weight: 500;
  font-size: clamp(18px, 4.6vw, 28px);
  letter-spacing: .38em;
  text-indent: .38em;
  color: #f3eee6;
  text-shadow: 0 2px 18px rgba(0,0,0,.55);
}
.slogan {
  margin: 0 0 10px;
  font-family: "TM Blackletter", "Times New Roman", serif;
  font-weight: 700;
  font-size: clamp(34px, 8.4vw, 58px);
  line-height: 1.05;
  letter-spacing: 0;
  color: #f6f0e6;
  text-shadow: 0 6px 24px rgba(0,0,0,.6);
}
.hero { position: relative; min-height: 100svh; display: grid; align-items: end; }
.hero img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(10,8,7,.88) 8%, rgba(10,8,7,.15) 48%, rgba(10,8,7,.4)); }

.hero-copy { position: relative; padding: 0 22px calc(36px + env(safe-area-inset-bottom)); width: min(640px, 100%); }
.hero .slogan { margin-bottom: 22px; }
.glass {
  display: flex;
  width: min(360px, 100%);
  padding: 5px;
  border-radius: 999px;
  background: linear-gradient(180deg, rgba(255,255,255,.18), rgba(255,255,255,.05));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.35),
    inset 0 -1px 0 rgba(0,0,0,.25),
    0 10px 30px rgba(0,0,0,.28);
  border: 1px solid rgba(255,255,255,.28);
  backdrop-filter: blur(18px) saturate(1.2);
  -webkit-backdrop-filter: blur(18px) saturate(1.2);
}
.glass a {
  flex: 1;
  min-height: 42px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  font-family: "TM Classic", "Palatino Linotype", Palatino, serif;
  font-size: 11px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(243,238,230,.72);
}
.glass a.on {
  background: radial-gradient(120% 140% at 50% 0%, rgba(255,255,255,.28), rgba(20,16,12,.55));
  color: #f6f0e6;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.4),
    0 6px 16px rgba(0,0,0,.25);
}
.lookbook { display: block; }
.band { position: relative; height: 38vh; min-height: 220px; display: grid; place-items: center; overflow: hidden; }
.band img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.band p {
  position: relative;
  margin: 0;
  font-family: var(--serif);
  font-size: clamp(22px, 4.2vw, 40px);
  text-align: center;
  padding: 16px 20px;
  text-shadow: 0 10px 28px rgba(0,0,0,.55);
}
@media (min-width: 900px) { .band { height: 42vh; } }
.empty { padding: 88px 24px; text-align: center; display: grid; justify-items: center; gap: 22px; }
.empty h2 { font-size: clamp(36px, 7vw, 64px); margin: 0; max-width: 16ch; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 48px 0; }
.photo { position: relative; aspect-ratio: 1; background: var(--raised); }
.photo img { width: 100%; height: 100%; object-fit: cover; }
.photo em { position: absolute; left: 12px; bottom: 12px; background: var(--ground); padding: 5px 8px; font-style: normal; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; }
.meta { display: flex; justify-content: space-between; padding-top: 12px; }
.meta h3 { font-family: var(--serif); font-size: 28px; font-weight: 400; margin: 0; }
@media (max-width: 720px) {
  .actions { display: flex; }
  .actions .btn { flex: 1; }
  .grid { grid-template-columns: 1fr; }
}
</style>
