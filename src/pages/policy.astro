---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Policy — TROTIE MAISON">
  <Header />
  <main class="container page">
    <p class="eyebrow">Policy</p>
    <h1 class="display">Ordering, simply.</h1>
    <p class="lead">Orders are handled directly through WhatsApp. Product availability and final details are confirmed before an order is completed.</p>
    <div class="three">
      <article><b>01</b><h2>Availability</h2><p>Listed availability is subject to confirmation. Sold-out pieces remain visible where appropriate.</p></article>
      <article><b>02</b><h2>Delivery</h2><p>Delivery across Nigeria. Fee confirmed on WhatsApp.</p></article>
      <article><b>03</b><h2>Before payment</h2><p>Price, availability and ordering details are confirmed with you on WhatsApp before payment.</p></article>
    </div>
  </main>
  <Footer />
</Base>
<style>
.page { padding: 64px 0; min-height: 62vh; }
.page h1 { font-size: clamp(48px, 9vw, 104px); margin: 0 0 24px; }
.lead { max-width: 640px; color: var(--mute); font-size: 19px; }
.three { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 72px; border-top: 1px solid var(--rule); }
.three article { padding: 28px 24px 8px 0; border-right: 1px solid var(--rule); }
.three article:last-child { border: 0; padding-right: 0; padding-left: 24px; }
.three b { font-size: 13px; letter-spacing: .16em; color: var(--mute); }
.three h2 { font-family: var(--serif); font-size: 28px; font-weight: 400; }
.three p { color: var(--mute); }
@media (max-width: 700px) {
  .three { grid-template-columns: 1fr; }
  .three article, .three article:last-child { padding: 24px 0; border-right: 0; border-bottom: 1px solid var(--rule); }
}
</style>
