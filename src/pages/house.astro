---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Base title="The House — TROTIE MAISON">
  <Header />
  <main>
    <section class="poster">
      <img src="/assets/lifestyle/red-convertible.jpg" alt="" />
      <div class="shade"></div>
      <h1 class="display overlay">THE<br />HOUSE</h1>
    </section>
    <section class="quiet container">
      <p class="eyebrow">Made for the top member.</p>
      <p>TROTIE MAISON is a watch retail house. Brand-new watches, selected in Nigeria. These pictures describe the house. They are not listed pieces.</p>
    </section>
    <section class="band">
      <img src="/assets/lifestyle/card-table.jpg" alt="" />
      <p>Quiet rooms. Clear choices.</p>
    </section>
  </main>
  <Footer />
</Base>
<style>
.poster { position: relative; min-height: 100svh; display: grid; place-items: center; }
.poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.shade { position: absolute; inset: 0; background: rgba(10,8,7,.28); }
.overlay { position: relative; text-align: center; font-size: clamp(72px, 22vw, 180px); line-height: .85; margin: 0; }
.quiet { padding: 72px 0; max-width: 640px; color: var(--mute); font-size: 20px; }
.band { position: relative; min-height: 70vh; display: grid; place-items: center; }
.band img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.band p { position: relative; font-family: var(--serif); font-size: clamp(28px, 5vw, 48px); margin: 0; }
</style>
