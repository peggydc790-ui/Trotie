---
import '../styles/tokens.css';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#100E0C" />
    <title>Atelier — TROTIE MAISON</title>
    <link rel="icon" type="image/png" href="/assets/tm-emblem-exact.png" />
  </head>
  <body>
    <div class="veil"></div>
    <header class="top">
      <a href="/" class="tm">tm</a>
      <p>Atelier</p>
    </header>

    <section id="gate" class="gate">
      <p class="eyebrow">Private room</p>
      <h1>The Atelier</h1>
      <p class="hint">Enter the house key to dress the collection.</p>
      <form id="gate-form" class="gate-form">
        <input id="key" type="password" autocomplete="current-password" placeholder="House key" />
        <button class="glass-pill on" type="submit">Enter</button>
      </form>
      <p id="gate-err" class="err" hidden>That key does not open this door.</p>
    </section>

    <main id="desk" hidden>
      <section class="hero-line">
        <div>
          <p class="eyebrow">Inventory desk</p>
          <h2>Dress the collection</h2>
        </div>
        <div class="hero-actions">
          <button class="glass-pill" id="export" type="button">Download products.json</button>
          <button class="glass-pill" id="leave" type="button">Lock atelier</button>
        </div>
      </section>

      <section class="desk-grid">
        <form id="piece-form" class="sheet">
          <p class="eyebrow">New piece</p>
          <label>Name<input name="name" required placeholder="The piece name" /></label>
          <label>Slug<input name="slug" required placeholder="the-piece-name" /></label>
          <label>Reference<input name="reference" placeholder="TM-001" /></label>
          <label>Price (NGN)<input name="price_ngn" type="number" min="0" step="1" required placeholder="0" /></label>
          <label>Status
            <select name="status">
              <option>Available</option>
              <option>Limited Stock</option>
              <option>Sold Out</option>
            </select>
          </label>
          <label>Short description<textarea name="description" rows="3" placeholder="Only facts you know."></textarea></label>
          <label>Photograph
            <input id="photo" name="photo" type="file" accept="image/*" />
          </label>
          <img id="preview" alt="" hidden />
          <label class="check"><input name="published" type="checkbox" checked /> Published</label>
          <button class="glass-pill on" type="submit">Save piece to desk</button>
        </form>

        <div class="sheet list-sheet">
          <p class="eyebrow">On the desk</p>
          <div id="list"></div>
          <p class="note">This desk keeps drafts in this browser. Download products.json and replace <code>content/products.json</code> in the site ZIP, then republish, to show pieces on the public house.</p>
        </div>
      </section>
    </main>
    <script is:inline>
    (() => {
      const KEY = 'tm-atelier-v1';
      const GATE = 'tm-atelier-open';
      const PASS = 'MAISON';
      const gate = document.getElementById('gate');
      const desk = document.getElementById('desk');
      const err = document.getElementById('gate-err');
      const listEl = document.getElementById('list');
      const preview = document.getElementById('preview');
      let photoData = '';

      const read = () => {
        try {
          const a = JSON.parse(localStorage.getItem(KEY) || '[]');
          return Array.isArray(a) ? a : [];
        } catch { return []; }
      };
      const write = (a) => localStorage.setItem(KEY, JSON.stringify(a));

      const openDesk = () => {
        sessionStorage.setItem(GATE, '1');
        gate.hidden = true;
        desk.hidden = false;
        paint();
      };

      const paint = () => {
        const rows = read();
        if (!rows.length) {
          listEl.innerHTML = '<p class="empty">No pieces on the desk.</p>';
          return;
        }
        listEl.innerHTML = rows.map((p, i) => `
          <article class="row">
            ${p.images?.[0] ? `<img src="${p.images[0]}" alt="">` : '<div class="ph"></div>'}
            <div>
              <strong>${p.name || 'Untitled'}</strong>
              <span>${p.reference || '—'} · ${p.status} · ₦${Number(p.price_ngn || 0).toLocaleString('en-NG')}</span>
            </div>
            <button type="button" data-del="${i}">Remove</button>
          </article>
        `).join('');
        listEl.querySelectorAll('[data-del]').forEach((b) => {
          b.addEventListener('click', () => {
            const a = read();
            a.splice(Number(b.getAttribute('data-del')), 1);
            write(a);
            paint();
          });
        });
      };

      document.getElementById('gate-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const v = (document.getElementById('key').value || '').trim().toUpperCase();
        if (v === PASS) openDesk();
        else err.hidden = false;
      });
      if (sessionStorage.getItem(GATE) === '1') openDesk();

      document.getElementById('photo').addEventListener('change', (e) => {
        const f = e.target.files && e.target.files[0];
        if (!f) { photoData = ''; preview.hidden = true; return; }
        const r = new FileReader();
        r.onload = () => { photoData = String(r.result || ''); preview.src = photoData; preview.hidden = false; };
        r.readAsDataURL(f);
      });

      document.getElementById('piece-form').addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(e.currentTarget);
        const slug = String(fd.get('slug') || '').toLowerCase().replace(/[^a-z0-9-]+/g, '-').replace(/^-|-$/g, '');
        const piece = {
          slug,
          name: String(fd.get('name') || '').trim(),
          reference: String(fd.get('reference') || '').trim(),
          price_ngn: Number(fd.get('price_ngn') || 0),
          status: String(fd.get('status') || 'Available'),
          description: String(fd.get('description') || '').trim(),
          images: photoData ? [photoData] : [],
          published: fd.get('published') === 'on'
        };
        const a = read();
        const i = a.findIndex((x) => x.slug === slug);
        if (i >= 0) a[i] = piece; else a.push(piece);
        write(a);
        e.currentTarget.reset();
        photoData = '';
        preview.hidden = true;
        paint();
      });

      document.getElementById('export').addEventListener('click', () => {
        const blob = new Blob([JSON.stringify(read(), null, 2)], { type: 'application/json' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'products.json';
        a.click();
      });
      document.getElementById('leave').addEventListener('click', () => {
        sessionStorage.removeItem(GATE);
        location.reload();
      });
    })();
    </script>
    <style>
      html, body { margin: 0; min-height: 100%; background: #0b0908; color: #f3eee6; font-family: "TM Sans", "Helvetica Neue", sans-serif; }
      .veil { position: fixed; inset: 0; background: radial-gradient(80% 60% at 50% 0%, #2a1814 0%, #0b0908 55%); pointer-events: none; }
      .top, .gate, #desk { position: relative; }
      .top { display: flex; justify-content: space-between; align-items: center; padding: 22px 24px; }
      .tm { font-family: "TM Serif", serif; font-size: 28px; color: inherit; text-decoration: none; }
      .gate { min-height: 70vh; display: grid; place-content: center; text-align: center; gap: 10px; padding: 24px; }
      .gate h1, #desk h2 { font-family: "TM Classic", Palatino, serif; letter-spacing: .18em; font-weight: 500; font-size: clamp(36px, 8vw, 72px); margin: 0; }
      .hint, .note, .empty { color: #9a9288; }
      .gate-form { display: grid; gap: 12px; width: min(360px, 100%); margin: 18px auto 0; }
      input, select, textarea {
        width: 100%;
        background: rgba(255,255,255,.04);
        border: 1px solid rgba(255,255,255,.16);
        color: #f3eee6;
        padding: 12px 14px;
        font: inherit;
      }
      .err { color: #c9a08a; }
      #desk { width: min(1100px, calc(100% - 32px)); margin: 0 auto 80px; }
      .hero-line { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 10px 0 28px; }
      .hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
      .desk-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: 18px; }
      .sheet {
        padding: 22px;
        border-radius: 28px;
        border: 1px solid rgba(255,255,255,.14);
        background: linear-gradient(180deg, rgba(255,255,255,.07), rgba(255,255,255,.02));
        backdrop-filter: blur(18px);
        display: grid; gap: 12px;
      }
      label { display: grid; gap: 6px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: #c9c1b5; }
      .check { display: flex; align-items: center; gap: 8px; text-transform: none; letter-spacing: 0; }
      #preview { max-height: 180px; object-fit: cover; border-radius: 16px; }
      .row { display: grid; grid-template-columns: 64px 1fr auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.08); }
      .row img, .ph { width: 64px; height: 64px; object-fit: cover; background: #1a1612; }
      .row span { display: block; color: #9a9288; font-size: 13px; }
      .row button { background: none; border: 0; color: #c9a08a; }
      @media (max-width: 800px) { .desk-grid { grid-template-columns: 1fr; } }
    </style>
  </body>
</html>
